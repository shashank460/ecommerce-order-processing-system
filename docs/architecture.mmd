flowchart LR
  Client --> Gateway
  Gateway --> Product
  Gateway --> Order
  Product --> PG[(PostgreSQL)]
  Product --> Redis[(Redis)]
  Order --> PG
  Order --> Kafka[(Kafka)]
  Order --> Inventory
  Inventory --> PG
  Inventory --> Kafka
  Inventory -->|gRPC| Order
  Kafka --> Payment
  Kafka --> Notification
  Payment --> PG
  Notification --> PG
  Gateway --> Prometheus
  Prometheus --> Grafana
  Gateway -.trace.-> OTel[OpenTelemetry]
  Order -.trace.-> OTel
  Inventory -.trace.-> OTel
