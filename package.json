{
  "name": "ecommerce-order-processing-system",
  "private": true,
  "workspaces": ["services/*"],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces --if-present",
    "coverage": "npm test --workspaces --if-present -- --coverage",
    "dev": "docker compose up --build",
    "format": "npx prettier --write \"**/*.{ts,js,json,yml,yaml,md}\"",
    "format:check": "npx prettier --check \"**/*.{ts,js,json,yml,yaml,md}\"",
    "k8s:validate": "kubectl kustomize k8s/overlays/hardened >/dev/null"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
